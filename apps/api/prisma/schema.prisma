/// Student - Santri/Siswa
model Student {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  unitId       String   @map("unit_id")
  /// Cuplikan NIS di unit santri SEKARANG. Sumbernya `student_unit_identifiers`:
  /// NIS milik unit yang menerbitkannya, jadi SD IT dan SMP IT boleh memakai
  /// nomor yang sama — keunikannya per unit (@@unique [unitId, nis] di sana),
  /// bukan per yayasan. Kolom ini sengaja dipertahankan (bukan dibuang) supaya
  /// image rilis sebelumnya tetap bisa membaca dan menulis.
  nis          String   // Nomor Induk Siswa (unik per unit, lihat StudentUnitIdentifier)
  /// Nomor Induk Siswa Nasional: 10 digit angka, satu untuk satu peserta didik
  /// seumur hidup. Unik bila diisi, dan bentuknya dijaga CHECK
  /// `students_nisn_format_check` (migrasi 20260914000000).
  nisn         String?  @unique
  gender       Gender
  birthPlace   String   @map("birth_place")
  birthDate    DateTime @map("birth_date")
  address      String
  parentName   String   @map("parent_name")
  parentPhone  String   @map("parent_phone")
  parentEmail  String?  @map("parent_email")
  photoUrl     String?  @map("photo_url")
  /// Kosakatanya di `packages/shared/src/types/student-status.ts`
  /// (STUDENT_STATUS) dan diikat CHECK `students_status_check`.
  /// HURUF KECIL — 2026-09-13 ada 23 tempat yang menyaring/menulis 'ACTIVE'
  /// huruf besar, semuanya nol tanpa galat. Jangan mengetik literalnya lagi.
  status       String   @default("active") // active, alumni, dropped, transferred
  entryYear    Int?     @map("entry_year")
  graduateYear Int?     @map("graduate_year")

  // === PHASE 8: Indonesia Compliance Fields (Dapodik/EMIS) ===
  /// NIK: 16 digit angka, unik bila diisi (CHECK `students_nik_format_check`).
  /// Data pribadi anak — UU 27/2022 Ps. 4. Tidak pernah dicetak di kartu santri.
