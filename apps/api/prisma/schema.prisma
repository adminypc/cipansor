enum DocumentType {
  BIRTH_CERTIFICATE // Akta kelahiran
  FAMILY_CARD // Kartu Keluarga
  ID_CARD // KTP (orang tua)
  STUDENT_CARD // Kartu pelajar
  REPORT_CARD // Rapor
  DIPLOMA // Ijazah
  CERTIFICATE // Sertifikat/piagam
  MEDICAL_RECORD // Rekam medis
  PHOTO // Pas foto
  RECOMMENDATION // Surat rekomendasi
  OTHER // Lainnya
}

enum DocumentStatus {
  PENDING // Menunggu verifikasi
  VERIFIED // Terverifikasi
  REJECTED // Ditolak
  EXPIRED // Kedaluwarsa
}

/// StudentDocument - Dokumen Siswa
model StudentDocument {
  id              String         @id @default(uuid())
  studentId       String         @map("student_id")
  documentType    DocumentType   @map("document_type")
  title           String // Nama dokumen
  description     String?
  fileUrl         String         @map("file_url")
  fileSize        Int?           @map("file_size") // Ukuran file dalam bytes
  mimeType        String?        @map("mime_type")
  // Validity
  issueDate       DateTime?      @map("issue_date")
  expiryDate      DateTime?      @map("expiry_date")
  documentNumber  String?        @map("document_number") // Nomor dokumen
  // Verification
  status          DocumentStatus @default(PENDING)
  verifiedById    String?        @map("verified_by_id")
  verifiedAt      DateTime?      @map("verified_at")
  rejectionReason String?        @map("rejection_reason")
  // Upload info
  uploadedById    String         @map("uploaded_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  // Relations
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation("DocumentVerifier", fields: [verifiedById], references: [id])
  uploadedBy User    @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([studentId])
  @@index([documentType])
  @@index([status])
  @@map("student_documents")
}

/// DigitalCertificate - Sertifikat Digital
model DigitalCertificate {
  id                String   @id @default(uuid())
  studentId         String   @map("student_id")
  // Certificate details
  certificateType   String   @map("certificate_type") // IJAZAH, STTB, TAHFIDZ, ACHIEVEMENT, etc
  title             String
  description       String?  @db.Text
  // Numbers & codes
  certificateNumber String   @unique @map("certificate_number")
  qrCode            String   @unique @map("qr_code") // QR untuk verifikasi
  verificationUrl   String   @map("verification_url")
  // Content
  grade             String? // Nilai/predikat
  rank              Int? // Peringkat
  issueDate         DateTime @map("issue_date")
  // Signatures
  signatoryName     String   @map("signatory_name") // Nama penandatangan
  signatoryTitle    String   @map("signatory_title") // Jabatan penandatangan
  signatureUrl      String?  @map("signature_url") // URL tanda tangan digital
  // File
  pdfUrl            String?  @map("pdf_url")
  thumbnailUrl      String?  @map("thumbnail_url")
  // Render data
  /// What the printed certificate carries that the generic renderer cannot
  /// derive from `title`/`grade` alone — the juz/name for a sanad, the qira'ah
  /// and silsilah for a sanad qiraah, the completed juz for a tahfidz syahadah.
  /// Persisted at mint time so the public download reproduces the document the
  /// issuer printed instead of a generic one. Shape is per certificate type and
  /// deliberately open (`Record<string, unknown>`); the renderer reads the keys
  /// it knows and ignores the rest.
  metadata          Json?    @map("metadata")
  // Meta
  isPublic          Boolean  @default(false) @map("is_public")
  downloadCount     Int      @default(0) @map("download_count")
  createdById       String   @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  student   Student @relation(fields: [studentId], references: [id])
  createdBy User    @relation("CertificateCreator", fields: [createdById], references: [id])

  @@index([studentId])
  @@index([certificateType])
  @@index([issueDate])
  @@map("digital_certificates")
}

