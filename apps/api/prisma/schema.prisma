  laundryDelivered                  LaundryTransaction[]        @relation("LaundryDeliverer")
  laundryStatusLogs                 LaundryStatusLog[]          @relation("LaundryStatusChanger")
  // Payroll relations
  payrollPeriodsCreated             PayrollPeriod[]             @relation("PayrollPeriodCreator")
