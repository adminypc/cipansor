  @@index([email])
  @@index([role])
  @@index([unitId])
  @@map("users")
}

/// RefreshToken - JWT refresh tokens
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Unit - Pesantren, Sekolah, or other educational institutions
model Unit {
  id            String    @id @default(uuid())
  foundationId  String?   @map("foundation_id")
  name          String
  type          UnitType
  address       String
  phone         String?
  email         String?
  logoUrl       String?   @map("logo_url")
  npsn          String?   @unique // Nomor Pokok Sekolah Nasional
  /// The name on the operating permit and in the national reference data
  /// ("SMP IT Pesantren Cipansor"). Documents print it — letterhead, rapor,
  /// certificates, Dapodik — and screens keep the short `name`. Null: documents
  /// print `name` (`unitDocumentName`).
  officialName          String?   @map("official_name")
  /// Izin operasional / izin pendirian: number and date as the permit gives them.
  operatingPermitNumber String?   @map("operating_permit_number")
  operatingPermitDate   DateTime? @map("operating_permit_date") @db.Date
