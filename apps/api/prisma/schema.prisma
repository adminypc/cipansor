// =====================================
// CLINIC & SCHOLARSHIP SCORING (from PR #313, hardened)
// =====================================

/// Patient - Umum (Luar Pesantren)
model Patient {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id") // Link ke User jika terdaftar
  name      String
  gender    Gender
  birthDate DateTime @map("birth_date")
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user           User?               @relation(fields: [userId], references: [id])
  medicalRecords MedicalRecord[]
  appointments   ClinicAppointment[]
  prescriptions  Prescription[]

  @@map("patients")
}

/// ClinicAppointment - Reservasi Klinik
model ClinicAppointment {
  id           String      @id @default(uuid())
  unitId       String      @map("unit_id")
  patientId    String?     @map("patient_id")
  studentId    String?     @map("student_id")
  userId       String?     @map("user_id") // Pengguna yang membuat reservasi
  appointmentDate DateTime @map("appointment_date")
  complaint    String      @db.Text
  status       String      @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  queueNumber  Int?        @map("queue_number")
  processedById String?    @map("processed_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  unit        Unit     @relation(fields: [unitId], references: [id])
  patient     Patient? @relation(fields: [patientId], references: [id])
  student     Student? @relation(fields: [studentId], references: [id])
  reservedBy  User?    @relation("PatientReserved", fields: [userId], references: [id])
  processedBy User?    @relation("AppointmentProcessor", fields: [processedById], references: [id])

  @@index([unitId])
  @@index([appointmentDate])
  @@map("clinic_appointments")
}

/// Prescription - Resep Obat
model Prescription {
  id              String   @id @default(uuid())
  medicalRecordId String?  @unique @map("medical_record_id")
  patientId       String?  @map("patient_id")
  studentId       String?  @map("student_id")
  doctorId        String   @map("doctor_id")
  notes           String?  @db.Text
  status          String   @default("PENDING") // PENDING, FULFILLED, CANCELLED
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  patient     Patient?           @relation(fields: [patientId], references: [id])
  student     Student?           @relation(fields: [studentId], references: [id])
  doctor      User               @relation("PrescriptionCreator", fields: [doctorId], references: [id])
  items       PrescriptionItem[]

  @@index([patientId])
  @@index([studentId])
  @@map("prescriptions")
