  @@unique([kitabId, studentId, academicYearId])
  @@index([kitabId])
  @@index([studentId])
  @@index([teacherId])
  @@map("kitab_progress")
}

/// Muhadhoroh - Latihan Pidato/Ceramah
model Muhadhoroh {
  id            String    @id @default(uuid())
  unitId        String    @map("unit_id")
  studentId     String    @map("student_id")
  scheduledAt   DateTime  @map("scheduled_at")
  // Performance details
  topic         String // Tema/judul pidato
  language      String    @default("Indonesian") // Bahasa: Indonesian, Arabic, English
  duration      Int? // Durasi dalam menit
  // Assessment
  contentScore  Int?      @map("content_score") // Nilai isi/konten (0-100)
  deliveryScore Int?      @map("delivery_score") // Nilai penyampaian (0-100)
  languageScore Int?      @map("language_score") // Nilai bahasa (0-100)
  totalScore    Int?      @map("total_score") // Nilai total
  grade         String? // Predikat
