// =====================================
// TATA NASKAH DINAS (E-OFFICE)
// =====================================

enum LetterDirection {
  INCOMING // Surat Masuk
  OUTGOING // Surat Keluar
}

/// Derajat kecepatan penyampaian naskah — bukan derajat kerahasiaan.
///
/// **Tiga derajat** (keputusan pengguna 2026-10-09,
/// `decisions/derajat-kecepatan-naskah.md`): **Sangat Segera** (hari yang sama,
/// batas 24 jam), **Segera** (2 × 24 jam), **Biasa** (menurut urutan). Pedoman
/// tata naskah dinas (Permenpan 80/2012, "Kecepatan Penyampaian") menamai
/// derajat teratas "Amat Segera/Kilat"; *amat* dan *sangat* bersinonim, jadi
/// `URGENT` tetap derajat 24 jam yang sama — arti baris lama tidak berubah.
/// Tidak ada derajat keempat.
enum LetterUrgency {
  NORMAL // Biasa
  IMMEDIATE // Segera — batas 2 x 24 jam
  URGENT // Sangat Segera — batas 24 jam
}

/// Jenis naskah dinas. Menentukan penomoran dan sifat yang boleh dipilih.
///
/// Sebelumnya tidak ada: setiap naskah diperlakukan sebagai surat dinas biasa,
/// sehingga surat keputusan dan surat tugas — yang penomoran dan kewenangan
/// tanda tangannya berbeda — tidak bisa dibedakan dari korespondensi biasa.
enum LetterType {
  SURAT_DINAS // Korespondensi resmi antar-instansi
  NOTA_DINAS // Korespondensi internal antar-pejabat
  SURAT_KEPUTUSAN // SK — produk hukum/penetapan
  SURAT_TUGAS // Penugasan perorangan/tim
  SURAT_EDARAN // Pemberitahuan berlaku umum
  SURAT_UNDANGAN
  SURAT_KETERANGAN
  BERITA_ACARA
  PENGUMUMAN
}

/// Sifat naskah — derajat kerahasiaan, bukan jenisnya.
///
/// TERBATAS ditambahkan belakangan. Tata naskah dinas mengenal empat derajat
/// (Biasa, Terbatas, Rahasia, Sangat Rahasia) dan model ini hanya punya tiga,
/// sehingga naskah "Terbatas" — yang hanya boleh dibaca kalangan tertentu —
/// terpaksa dicatat sebagai Biasa dan kehilangan pembatasannya. Nilai lama
/// tidak diubah namanya agar baris yang sudah ada tetap sah.
enum LetterNature {
  PUBLIC // Biasa
  LIMITED // Terbatas
  CONFIDENTIAL // Rahasia
  STRICTLY_CONFIDENTIAL // Sangat Rahasia
}

/// Dari mana byte naskah yang ditandatangani itu berasal.
///
/// Bukan rincian teknis. Kedua jalur menghasilkan jaminan yang **berbeda**, dan
/// halaman verifikasi publik yang mengaburkan bedanya lebih buruk daripada yang
/// mengakuinya:
///
/// - `GENERATED` — sistem yang menyusun naskahnya dari isian formulir. Metadata
///   di buku agenda dan isi dokumennya berasal dari satu sumber, jadi keduanya
///   tidak mungkin berselisih.
/// - `UPLOADED` — penyusun menulisnya di pengolah kata, mengekspor PDF, lalu
///   mengunggahnya. Byte-nya tetap di-hash, ditandatangani, dan diarsipkan
///   dengan cara yang persis sama — yang tidak dapat dijamin siapa pun adalah
///   bahwa *Perihal* di buku agenda sama dengan yang tertulis di dalam PDF-nya.
///   Tidak ada pemeriksaan yang dapat menemukan itu; yang ada hanyalah bahwa
///   seluruh pemeriksa dalam tangga persetujuan dan penanda tangan melihat PDF
///   yang sesungguhnya sebelum bertindak.
///
/// Seluruh baris hari ini bernilai `GENERATED`, dan itu pernyataan yang benar
/// dan dapat ditunjukkan, bukan asumsi: satu-satunya sumber byte yang
/// ditandatangani adalah `generateLetterPdfBuffer` di `esign.service.ts`.
/// `Letter.fileUrl` — berkas yang diunggah lewat "Upload File Naskah" —
/// **tidak** pernah menjadi byte yang ditandatangani, dan kolom ini ada
/// sebagian justru untuk membuat kenyataan itu terbaca alih-alih tersembunyi.
enum LetterAuthoringTrack {
  GENERATED
  UPLOADED
}

/// Garis kewenangan penandatanganan naskah dinas (a.n./u.b./Plt./Plh.).
///
/// Cerminan `SigningAuthorityForm` di `@cipansor/shared`; nilainya harus tetap
/// sama persis (dijaga `letter-signing-authority.test.ts`). Empat bentuk ini
/// mengikuti Peraturan BKN 16/2020 Pasal 242; NONE berarti ditandatangani atas
/// nama jabatan penanda tangan sendiri, yang paling lazim.
enum SigningAuthorityForm {
  NONE
  ATAS_NAMA
  UNTUK_BELIAU
  PELAKSANA_TUGAS
  PELAKSANA_HARIAN
}

enum LetterStatus {
  DRAFT // Konsep
  PENDING_REVIEW // Menunggu Paraf/Review
  REVISION_NEEDED // Perlu Revisi
  READY_TO_SIGN // Siap Tanda Tangan
  SIGNED // Sudah Ditandatangani
  SENT // Sudah Dikirim (untuk Surat Keluar)
  ARCHIVED // Diarsipkan
  DISPOSED // Sudah Didisposisikan (untuk Surat Masuk)
}

/// Setiap perbuatan yang mengubah perjalanan sebuah surat.
enum LetterFlowAction {
  CREATED // Surat dicatat/dibuat
  EDITED // Naskah surat diperbarui/diubah (bukan tindak lanjut disposisi)
  SUBMITTED // Konsep diajukan untuk diverifikasi
  APPROVED // Diparaf/disetujui oleh salah satu verifikator
  SIGNED // Ditandatangani oleh penandatangan akhir
  REVISION_REQUESTED // Dikembalikan ke pembuat untuk diperbaiki
  RESUBMITTED // Diajukan ulang setelah revisi
  DISPOSED // Didisposisikan ke pejabat berikutnya
  DISPOSITION_UPDATED // Penerima disposisi memperbarui/menyelesaikan tindak lanjut
  SENT // Surat keluar dikirim
  SIGNATURE_REVOKED // Tanda tangan elektronik dicabut — surat tidak lagi berlaku
  ARCHIVED // Surat diarsipkan — akhir alur
}

/// LetterFlowEvent - Histori Alur Surat
///
/// Catatan riwayat yang hanya bertambah (append-only): siapa melakukan apa,
/// kepada siapa, dan kapan. Sengaja terpisah dari LetterReviewer dan
/// Disposition karena keduanya menyimpan *keadaan sekarang* — status seorang
/// verifikator ditimpa setiap kali ia bertindak, dan catatan disposisi
/// sebelumnya sempat ditumpuk sebagai teks di satu kolom. Keduanya tidak bisa
/// menjawab "siapa yang mengembalikan surat ini, kapan, dengan catatan apa"
/// setelah surat itu diajukan ulang.
///
/// Tidak ada operasi update maupun delete pada tabel ini. Koreksi dilakukan
/// dengan menambah peristiwa baru, bukan dengan mengubah yang lama.
model LetterFlowEvent {
  id         String           @id @default(uuid())
  letterId   String           @map("letter_id")
  actorId    String           @map("actor_id") // Pelaku
  action     LetterFlowAction
  /// Pejabat tujuan, untuk perbuatan yang mengarah ke seseorang (disposisi).
  targetId   String?          @map("target_id")
  /// Status surat sebelum dan sesudah perbuatan ini, apa adanya.
  fromStatus LetterStatus?    @map("from_status")
  toStatus   LetterStatus?    @map("to_status")
  /// Catatan/instruksi yang menyertai perbuatan, tersimpan utuh per peristiwa.
  note       String?          @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")

  // Relations
  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  actor  User   @relation("LetterFlowActor", fields: [actorId], references: [id])
  target User?  @relation("LetterFlowTarget", fields: [targetId], references: [id])

  @@index([letterId, createdAt])
  @@index([actorId])
  @@map("letter_flow_events")
}

/// UserSigningKey - Kunci Tanda Tangan Elektronik Mandiri
///
/// Satu pasang kunci per pengguna. Kunci privat disimpan dalam keadaan
/// tersegel: hanya passphrase pemiliknya yang dapat membukanya, dan passphrase
/// itu tidak pernah disimpan di mana pun — tidak sebagai teks, tidak pula
/// sebagai hash. Bukti passphrase benar adalah kunci privat berhasil
/// didekripsi (lihat utils/esign.ts).
///
/// Konsekuensinya disengaja: passphrase yang lupa tidak dapat dipulihkan,
/// hanya dapat diganti dengan kunci baru — dan surat lama tetap terverifikasi
/// karena tiap tanda tangan menyimpan salinan kunci publiknya sendiri.
model UserSigningKey {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  algorithm           String    @default("Ed25519")
  publicKey           String    @map("public_key") @db.Text
  /// Sidik jari kunci publik — SHA-256 atas SPKI DER, ditulis sebagai pasangan
  /// heksadesimal (`AB:CD:…`). Lihat `publicKeyFingerprint` di `utils/esign.ts`:
  /// ini **bukan** `keyIdentifier` SHA-1 RFC 5280 §4.2.1.2.
  ///
  /// Disimpan, bukan dihitung saat dibaca, karena satu hal saja yang
  /// membutuhkannya dan hanya bisa dilakukan dengan cara itu: **layanan status
  /// kunci publik** (AATL ICA7) menerima *sidik jari* dari orang yang memegang
  /// surat, lalu menjawab apakah kunci itu masih berlaku. Mencari berdasarkan
  /// sidik jari menuntut kolom ini berindeks; menghitungnya di SQL tidak
  /// mungkin tanpa ekstensi kripto, dan menyisir seluruh baris pada endpoint
  /// publik adalah jalan yang lebih buruk.
  fingerprint         String?   @unique @map("fingerprint")
  encryptedPrivateKey String    @map("encrypted_private_key") @db.Text
  kdfSalt             String    @map("kdf_salt")
  /// Parameter scrypt saat kunci dibuat, agar dapat dinaikkan kelak tanpa
  /// membuat kunci lama tidak terbaca.
  kdfParams           Json      @map("kdf_params")
  iv                  String
  authTag             String    @map("auth_tag")
  /// Penahan tebakan passphrase.
  failedAttempts      Int       @default(0) @map("failed_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastUsedAt          DateTime? @map("last_used_at")

  /// Diterbitkan atas persetujuan Super Admin, dan berlaku terbatas.
  ///
  /// Status kedaluwarsa sengaja TIDAK disimpan sebagai kolom status: ia
  /// dihitung dari `expiresAt` setiap kali dibaca (utils/esign-lifecycle.ts).
  /// Menyimpannya menuntut ada penjadwal yang membalik status tepat waktu —
  /// dan bila penjadwal itu mati semalam, kunci yang sudah lewat masa
  /// berlakunya masih bisa dipakai menandatangani.
  approvedById        String?   @map("approved_by_id")
  approvedAt          DateTime? @map("approved_at")
  expiresAt           DateTime? @map("expires_at")

  /// Pencabutan dicatat lengkap dengan pelakunya. Mencabut wewenang
  /// menandatangani adalah tindakan yang harus dapat dipertanggungjawabkan
  /// kepada orang tertentu, bukan kepada "sistem".
  revokedAt           DateTime? @map("revoked_at")
  revokedReason       String?   @map("revoked_reason") @db.Text
  /// Sebab pencabutan menurut RFC 5280 §5.3.1.
  ///
  /// Bukan hiasan: hanya KEY_COMPROMISE yang membuat surat-surat yang telanjur
  /// ditandatangani menjadi meragukan. Untuk pejabat yang berhenti atau kunci
  /// yang diterbitkan ulang, surat-surat itu tetap sah dan memang harus tetap
  /// sah. Tanpa kode ini, keduanya tampak sama di mata petugas yang mencabut.
  revocationCode      SigningKeyRevocationCode? @map("revocation_code")
  revokedById         String?   @map("revoked_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("SigningKeyApprover", fields: [approvedById], references: [id])
  revokedBy  User? @relation("SigningKeyRevoker", fields: [revokedById], references: [id])

  @@map("user_signing_keys")
}

/// Riwayat status kunci tanda tangan — jejak kunci yang sudah tidak aktif.
///
/// **Kenapa terpisah dari `UserSigningKey`.** Tabel itu menahan ikatan
/// tepat satu kunci aktif per pengguna (`@unique` pada `user_id`), dan kolom
/// `encryptedPrivateKey`-nya wajib diisi. Penerbitan ulang kunci menghapus
/// barisnya supaya pemiliknya dapat menetapkan passphrase baru — dan sejak itu
/// sidik jari yang tercetak pada surat-surat lama menjadi "tidak dikenal" di
/// layanan status publik, padahal suratnya masih dapat diverifikasi (tanda
/// tangannya menyimpan salinan kunci publiknya sendiri). Penerima yang memeriksa
/// arsip melihat UNKNOWN, bukan EXPIRED, dan kehilangan alasan serta tanggal
/// pencabutannya.
///
/// Baris di sini ditulis **sebelum** kunci aktif dihapus, hanya berisi metadata
/// publik (tanpa kunci privat, tanpa salt/iv/authTag), dan sengaja kekal:
/// menghapusnya memulihkan kebuntuan yang ia ada untuk mencegah. Sidik jari
/// unik di sini, seperti di sumbernya.
model SigningKeyStatusRecord {
  id             String    @id @default(uuid())
  /// Pemilik kunci. Bukan relasi ber-`onDelete: Cascade`: bila pengguna
  /// dihapus, sidik jari yang tercetak di surat tetap harus terjawab.
  userId         String    @map("user_id")
  fingerprint    String    @unique
  algorithm      String    @default("Ed25519")
  approvedAt     DateTime? @map("approved_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  revokedReason  String?   @map("revoked_reason") @db.Text
  revocationCode SigningKeyRevocationCode? @map("revocation_code")
  /// Kapan kunci aktif digantikan — jejak waktu peralihan.
  supersededAt   DateTime  @default(now()) @map("superseded_at")

  @@index([userId])
  @@map("signing_key_status_records")
}

/// Sebab pencabutan kunci, mengikuti RFC 5280 §5.3.1.
///
/// Adobe AATL (ICA6.a) menuntut kemampuan mencabut "segera setelah kehilangan,
/// pengungkapan, atau kompromi lain atas kunci privat pelanggan, ketika ada
/// masalah keamanan atau integritas, atau ketika keterangan yang disertifikasi
/// berubah" — tiga keadaan yang berbeda akibatnya, dan itulah yang dibedakan
/// kode-kode ini.
enum SigningKeyRevocationCode {
  /// Passphrase atau kunci privatnya diduga bocor. SATU-SATUNYA sebab yang
  /// membuat surat-surat yang telanjur ditandatangani menjadi meragukan.
  KEY_COMPROMISE
  /// Pemegangnya berhenti menjabat atau wewenang menandatanganinya dicabut.
  /// Surat-surat yang lalu tetap sah — memang begitu yang dikehendaki.
  AFFILIATION_CHANGED
  /// Diterbitkan ulang; kunci ini digantikan yang baru.
  SUPERSEDED
  /// Tidak lagi dipakai, tanpa dugaan kebocoran.
  CESSATION_OF_OPERATION
  /// Kekeliruan penerbitan — kunci ini semestinya tidak pernah terbit.
  PRIVILEGE_WITHDRAWN
}

/// SigningKeyRequest - Pengajuan Penerbitan / Perpanjangan Kunci Tanda Tangan
///
/// Kunci tanda tangan tidak diterbitkan sendiri oleh penggunanya: ia diajukan,
/// lalu disetujui Super Admin yang sekaligus menentukan masa berlakunya. Tabel
/// ini menyimpan pengajuan beserta putusannya, dan tidak pernah dihapus —
/// riwayat siapa memberi wewenang menandatangani, kapan, dan untuk berapa
/// lama, adalah bagian dari pertanggungjawaban.
/// UserIdentity - Identitas yang menjadi dasar sebuah kunci tanda tangan
///
/// Sebuah tanda tangan elektronik mengikat kepada **orang**, dan ia hanya
/// mengikat sejauh penerbitnya tahu siapa orang itu. Sebelum tabel ini, kunci
/// diterbitkan kepada sebuah baris `User` yang identitasnya hanya nama dan
/// surel — sehingga tanda tangan membuktikan "seseorang yang tahu passphrase
/// kunci yang kami terbitkan untuk user-id X", dan tidak ada apa pun di sistem
/// yang menyatakan siapa X di dunia nyata.
///
/// Ruas-ruasnya mengikuti apa yang dikumpulkan penerbit sertifikat sungguhan:
/// nama sesuai kartu identitas, NIK, tempat dan tanggal lahir. Dalam sertifikat
/// X.509, NIK inilah yang menjadi `serialNumber` subjeknya dengan bentuk
/// `IDCID-<NIK>` menurut ETSI EN 319 412-2 — jadi menyimpannya sekarang bukan
/// persiapan spekulatif, melainkan ruas yang sama yang akan dipakai bila
/// yayasan kelak memakai PSrE.
///
/// Melekat pada pengguna, bukan pada kunci: identitas seseorang bertahan
/// melewati setiap penerbitan ulang dan perpanjangan kuncinya.
model UserIdentity {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  /// Nama sebagaimana tertulis pada kartu identitas — bukan nama panggilan,
  /// dan bukan nama pada akun, yang boleh saja disingkat.
  legalName String @map("legal_name")
  /// NIK, 16 digit.
  ///
  /// Unik: satu nomor induk kependudukan tidak boleh menjadi dasar dua akun
  /// penandatangan. Tanpa itu, seseorang yang punya dua akun dapat memegang
  /// dua kunci yang sama-sama mengaku dirinya, dan pencabutan salah satunya
  /// tidak menghentikan yang lain.
  nik        String    @unique
  birthPlace String    @map("birth_place")
  birthDate  DateTime  @map("birth_date") @db.Date

  /// Kapan seorang Super Admin menyatakan identitas ini benar.
  ///
  /// Kosong berarti belum diverifikasi, dan kunci tidak boleh terbit. Setiap
  /// perubahan pada keempat ruas di atas mengosongkannya kembali: verifikasi
  /// menyatakan data *yang itu* sudah dicocokkan, bukan bahwa orangnya pernah
  /// diperiksa sekali seumur hidup.
  verifiedAt   DateTime? @map("verified_at")
  verifiedById String?   @map("verified_by_id")
  /// Catatan penyetuju saat mencocokkan — inilah artefak yang lestari.
  ///
  /// Bukan gambarnya. Pindaian KTP adalah data pribadi bersifat spesifik yang
  /// harus dijaga selama ia disimpan; catatan bahwa seorang pejabat tertentu
  /// telah mencocokkannya pada tanggal tertentu, terhadap berkas ber-hash
  /// tertentu, menjawab pertanyaan yang sama — berukuran beberapa baris, dan
  /// tidak menjadi sasaran bila basis data ini bocor.
  verificationNote   String?                     @map("verification_note") @db.Text

  /// Berkas foto KTP, selama masa hidupnya yang pendek.
  ///
  /// Disimpan **di luar** `public/uploads`. Direktori itu disajikan di balik
  /// `uploadsAuth`, yang menurut komentarnya sendiri adalah autentikasi dan
  /// bukan otorisasi: setiap token yang sah membuka setiap berkas di sana. Foto
  /// KTP karena itu tidak boleh melewatinya — ia hanya boleh terbaca oleh Super
  /// Admin yang sedang memutuskan, lewat endpoint yang memeriksanya dan
  /// mencatat setiap pembacaan.
  ///
  /// **Ditolak → dihapus seketika. Disetujui → disimpan sampai `ktpRetainUntil`.**
  ///
  /// Pengajuan yang ditolak tidak menerbitkan kunci, sehingga berkasnya tidak
  /// membuktikan apa pun lagi, dan data pribadi yang disimpan tanpa keperluan
  /// hanyalah kewajiban tanpa manfaat.
  ///
  /// Pengajuan yang disetujui lain persoalannya. Menghapusnya saat itu juga
  /// membuat pertanyaan "tunjukkan kartu yang Anda periksa" tidak dapat
  /// dijawab — dan justru pertanyaan itulah yang membuat bukti registrasi
  /// disimpan dalam praktik yang baku: eIDAS Ps. 24.2(h) mewajibkan
  /// penyelenggara menyimpan informasi registrasi "untuk keperluan pembuktian
  /// dalam proses hukum", dan CA/Browser Forum menetapkan **tujuh tahun
  /// setelah sertifikat berhenti berlaku**. Hash saja tidak menggantikannya:
  /// ia dapat memutuskan apakah sebuah salinan identik, tetapi tidak dapat
  /// memunculkan kembali apa yang diperiksa.
  ///
  /// Yang tetap berlaku: **pemohon kehilangan aksesnya begitu diputuskan.** Ia
  /// sudah memegang kartunya sendiri, sehingga menutup jalur baca itu tidak
  /// merugikannya dan menghapus satu jalan penyadapan bila sesinya dibajak.
  /// Hanya Super Admin yang dapat membukanya, lewat satu endpoint yang
  /// mencatat setiap pembacaan.
  ktpFileName   String?   @map("ktp_file_name")
  ktpSha256     String?   @map("ktp_sha256")
  ktpUploadedAt DateTime? @map("ktp_uploaded_at")
  /// Batas simpan berkasnya. Lewat tanggal ini ia dihapus oleh
  /// `db:purge-identity-documents`, dan `ktpDeletedAt` mencatat bahwa itu
  /// benar-benar terjadi — kolom kosong tidak dapat membedakan "sudah dihapus"
  /// dari "tidak pernah ada".
  ktpRetainUntil DateTime? @map("ktp_retain_until")
  ktpDeletedAt   DateTime? @map("ktp_deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User  @relation("IdentitySubject", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("IdentityVerifier", fields: [verifiedById], references: [id])

  @@map("user_identities")
}

model SigningKeyRequest {
  id       String                @id @default(uuid())
  userId   String                @map("user_id")
  kind     SigningKeyRequestKind
  status   SigningKeyRequestStatus @default(PENDING)
  /// Alasan pengajuan dari pemohon.
  reason   String?               @db.Text

  /// Diisi Super Admin saat memutuskan.
  decidedById   String?   @map("decided_by_id")
  decidedAt     DateTime? @map("decided_at")
  decisionNote  String?   @map("decision_note") @db.Text
  /// Masa berlaku yang diberikan, dalam hari. Ditentukan saat menyetujui,
  /// bukan konstanta global — penyetuju-lah yang menanggung keputusannya.
  grantedDays   Int?      @map("granted_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User  @relation("SigningKeyRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("SigningKeyDecider", fields: [decidedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("signing_key_requests")
}

enum SigningKeyRequestKind {
  ENROLLMENT // Penerbitan pertama, atau penerbitan ulang setelah kedaluwarsa/dicabut
  RENEWAL    // Perpanjangan sebelum masa berlaku habis
}

enum SigningKeyRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// LetterSignature - Tanda Tangan Elektronik pada Surat
///
/// Menyimpan tanda tangan beserta bahan untuk memeriksanya kembali: ringkasan
/// naskah yang ditandatangani, tanda tangannya, dan salinan kunci publik yang
/// dipakai. Dengan begitu keaslian surat dapat diperiksa tanpa perlu percaya
/// pada baris lain di basis data ini.
model LetterSignature {
  id        String @id @default(uuid())
  letterId  String @map("letter_id")
  signerId  String @map("signer_id")
  algorithm String

  /// Salinan kunci publik saat penandatanganan — bukan rujukan ke kunci
  /// pengguna saat ini, agar pencabutan/penggantian kunci tidak membuat surat
  /// yang sudah sah menjadi tampak palsu.
  publicKey String @map("public_key") @db.Text
  /// SHA-256 bentuk kanonik naskah (utils/esign.ts).
  digest    String
  signature String @db.Text

  /// Dimuat QR. Acak, bukan turunan id surat, supaya daftar surat tidak dapat
  /// disisir lewat halaman verifikasi publik.
  verificationToken String    @unique @map("verification_token")
  signedAt          DateTime  @default(now()) @map("signed_at")

  /// Hash byte SHA-256 dari PDF final dan tanda tangan Ed25519 atas hash tersebut.
  pdfHash           String?   @unique @map("pdf_hash")
  pdfSignature      String?   @map("pdf_signature") @db.Text
  /// Jabatan yang dipegang penandatangan SAAT menandatangani.
  ///
  /// Kewenangan mencabut diukur terhadap jabatan ini, bukan terhadap jabatan
  /// orang itu hari ini — sebuah SK yang ditandatangani Ketua tetap naskah
  /// Ketua walaupun penandatangannya kini menjabat yang lain.
  signerRoleCode    String?   @map("signer_role_code")

  /// Garis kewenangan penandatanganan (a.n./u.b./Plt./Plh.) — lihat
  /// `@cipansor/shared/letter-signing-authority`.
  ///
  /// Disimpan pada baris tanda tangan, bukan pada surat, karena ia milik
  /// perbuatan menandatangani: sebuah naskah hanya ditandatangani sekali, dan
  /// bentuk yang dipakai saat itu tidak boleh berubah setelahnya. Nilainya
  /// ikut ditandatangani (`canonicalPayload`), sehingga mengubahnya membuat
  /// tanda tangannya tidak lagi cocok — sama seperti mengubah isi naskahnya.
  /// `NONE` (atas jabatan sendiri) untuk naskah tanpa garis kewenangan dan
  /// untuk baris sebelum kolom ini ada — sama dengan migrasinya.
  signingAuthorityForm SigningAuthorityForm @default(NONE) @map("signing_authority_form")
  /// Jabatan pejabat yang diwakili, mis. "Kepala SMA Qur'an Cipansor".
  /// Dicetak pada naskah di depan singkatan garis kewenangannya.
  representedOffice String? @map("represented_office")

  /// Versi bentuk kanonik yang ditandatangani (`canonicalPayload`).
  ///
  /// `1` berakhir pada `signedAt`; `2` menambahkan garis kewenangan. Verifikasi
  /// wajib memakai versi ini, bukan bentuk terkini: sebuah tanda tangan lama
  /// dibuat atas byte `v1`, dan merekonstruksinya dengan `v2` menolak tanda
  /// tangan yang sah. NULL berarti baris dibuat sebelum kolom ini ada — yaitu
  /// `v1`, satu-satunya bentuk saat itu.
  canonicalVersion Int? @map("canonical_version")

  /// Pencabutan tidak menghapus baris: surat yang pernah beredar harus tetap
  /// dapat dijelaskan statusnya kepada yang memindai QR-nya.
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") @db.Text
  revokedById       String?   @map("revoked_by_id")
  revokedByRoleCode String?   @map("revoked_by_role_code")

  /// Nama pencabut **sebagaimana tercatat saat mencabut**, bukan namanya hari
  /// ini. Cap DICABUT mencetak nama ini dan hash salinan bercap dihitung atas
  /// nama itu — lihat `revokedSha256`. Selama nama dibaca dari `User.name`,
  /// satu penggantian nama menisbikan setiap salinan bercap yang sudah
  /// diunduh orang: byte-nya berubah, hashnya tak lagi cocok, dan salinan
  /// resmi sistem sendiri dijawab "tidak terdaftar".
  revokedByName     String?   @map("revoked_by_name")

  /// Hash SHA-256 salinan **bercap DICABUT** dari byte yang diarsipkan.
  ///
  /// Diisi saat naskah dicabut, supaya salinan bercap yang diunduh penerimanya
  /// dapat dikenali kembali lewat satu perbandingan tepat — tanpa membuat
  /// ulang capnya dan tanpa batas 200 tanda tangan tercabut terbaru. Ia hidup
  /// di sini, bukan di arsipnya (`LetterSignedDocument`), karena inilah baris
  /// yang menjawab pertanyaan "apakah tanda tangan ini dicabut" dan di sinilah
  /// `revokedByName` yang menjadi dasar capnya berada.
  ///
  /// NULL untuk pencabutan yang tercatat sebelum kolom ini ada; jalur cadangan
  /// (membuat ulang cap, terbatas) menanganinya.
  revokedSha256     String?   @map("revoked_sha256")

  /// Tanda tangan Ed25519 pencabut atas pernyataan pencabutannya.
  ///
  /// Pencabutan adalah pernyataan kriptografis, bukan sekadar kolom status —
  /// sebuah CRL pun struktur data yang ditandatangani (RFC 5280). Dengan ini,
  /// halaman verifikasi publik *membuktikan* pencabutannya, bukan sekadar
  /// mengklaimnya, dan sebuah sesi yang tertinggal terbuka tidak cukup untuk
  /// menarik surat resmi.
  revocationDigest    String? @map("revocation_digest")
  revocationSignature String? @map("revocation_signature") @db.Text
  revocationPublicKey String? @map("revocation_public_key") @db.Text

  letter    Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  signer    User   @relation("LetterSigner", fields: [signerId], references: [id])
  revokedBy User?  @relation("LetterSignatureRevoker", fields: [revokedById], references: [id])
  revocationRequests LetterRevocationRequest[]
  /// Byte naskah yang benar-benar ditandatangani — lihat LetterSignedDocument.
  document  LetterSignedDocument?

  @@unique([letterId, signerId])
  @@index([letterId])
  @@index([pdfHash])
  /// Indeks untuk pencocokan salinan bercap DICABUT (`revokedSha256 = ?`).
  /// Tanpa ini, setiap unggahan verifikasi publik memindai seluruh tabel tanda
  /// tangan — dan "tanpa batas" hanya berarti "seluruh tabel", bukan murah.
  @@index([revokedSha256])
  @@map("letter_signatures")
}

/// Byte PDF yang benar-benar ditandatangani, disimpan apa adanya.
///
/// Sebelum ini tidak ada berkas yang disimpan sama sekali: setiap unduhan
/// membuat ulang naskahnya, dan verifikasi publik bergantung pada janji bahwa
/// `generateLetterPdfBuffer` akan menghasilkan byte yang persis sama selamanya.
/// Janji itu tidak dapat ditepati oleh perangkat lunak yang hidup. Menaikkan
/// versi `pdf-lib`, mengubah satu spasi di kop surat, atau mendarat di build ICU
/// yang berbeda akan mengubah byte-nya — dan **seluruh surat yang pernah
/// ditandatangani gagal verifikasi sekaligus**, semuanya diumumkan kepada
/// publik sebagai naskah yang telah diubah. Repositori ini menerima pembaruan
/// dependensi setiap minggu, jadi ini bukan bahaya hipotetis.
///
/// Karena itu byte-nya diarsipkan pada saat penandatanganan, di dalam transaksi
/// yang sama, dan unduhan dilayani dari arsip ini. Naskah yang sudah
/// ditandatangani tidak pernah dirender ulang.
///
/// **Tabel tersendiri, bukan kolom pada `LetterSignature`.** Sebuah kolom
/// `Bytes` akan ikut terbaca oleh setiap kueri yang tidak menyebutkan `select`,
/// dan ikut menghuni halaman yang sama dengan kolom-kolom yang dibaca daftar
/// surat. Arsip hanya dibaca ketika berkasnya memang diminta.
model LetterSignedDocument {
  id          String @id @default(uuid())
  signatureId String @unique @map("signature_id")

  /// Byte PDF final, apa adanya. Inilah yang di-hash menjadi `pdfHash`.
  bytes    Bytes
  /// Salinan hash-nya, supaya arsip dapat memeriksa dirinya sendiri sebelum
  /// disajikan — sebuah berkas yang rusak di penyimpanan tidak boleh keluar
  /// diam-diam sebagai naskah resmi.
  sha256   String
  byteSize Int    @map("byte_size")

  /// Yang menghasilkan byte ini, untuk menelusuri perbedaan di kemudian hari.
  /// Naskah lama yang byte-nya tidak lagi dapat dibuat ulang tetap dapat
  /// dijelaskan: build inilah yang membuatnya.
  generator String

  archivedAt DateTime @default(now()) @map("archived_at")

  signature LetterSignature @relation(fields: [signatureId], references: [id], onDelete: Cascade)

  @@map("letter_signed_documents")
}

/// LetterRevocationRequest - Permohonan Pencabutan Naskah Dinas
///
/// Mengajukan dan memutuskan adalah dua perbuatan yang berbeda, oleh dua pihak
/// yang berbeda. Itu bukan birokrasi tambahan melainkan bentuk yang sudah
/// dipakai di mana-mana: pemilik sertifikat *mengajukan* pencabutan dengan
/// alasan tertulis, penerbitnya yang *memutuskan* (RFC 5280; prosedur BSrE
/// persis begitu).
///
/// Tanpa ini, petugas tata usaha yang menemukan nomor surat ganda tidak punya
/// saluran apa pun — sedangkan dialah yang paling mungkin menemukannya lebih
/// dahulu daripada pejabat yang berwenang mencabutnya.
model LetterRevocationRequest {
  id          String @id @default(uuid())
  letterId    String @map("letter_id")
  signatureId String @map("signature_id")
  requesterId String @map("requester_id")

  /// Dibaca publik bila permohonannya disetujui, karena inilah yang menjadi
  /// alasan pencabutan pada halaman verifikasi.
  reason        String  @db.Text
  /// Berkas pendukung — bukti nomor ganda, surat pengganti, notulen rapat.
  attachmentUrl String? @map("attachment_url")

  status       LetterRevocationRequestStatus @default(PENDING)
  decidedById  String?   @map("decided_by_id")
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @db.Text @map("decision_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  letter    Letter          @relation(fields: [letterId], references: [id], onDelete: Cascade)
  signature LetterSignature @relation(fields: [signatureId], references: [id], onDelete: Cascade)
  requester User            @relation("LetterRevocationRequester", fields: [requesterId], references: [id])
  decidedBy User?           @relation("LetterRevocationDecider", fields: [decidedById], references: [id])

  @@index([letterId])
  @@index([status])
  @@map("letter_revocation_requests")
}

enum LetterRevocationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Ditarik kembali oleh pemohonnya sebelum diputuskan.
  WITHDRAWN
}

/// FilingClassification - Kode Klasifikasi Arsip (Pola Klasifikasi)
model FilingClassification {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "000", "421"
  name        String // e.g. "Umum", "Pendidikan"
  description String?  @db.Text
  retention   Int?     @map("retention_years") // Masa retensi dalam tahun
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  letters Letter[]

  @@index([code])
  @@map("filing_classifications")
}

/// AgendaNumber - Penomoran Surat Otomatis
model AgendaNumber {
  id             String @id @default(uuid())
  unitId         String @map("unit_id")
  academicYearId String @map("academic_year_id")
  type           String // INCOMING, OUTGOING, SK, SURAT_TUGAS, etc.
  lastNumber     Int    @default(0) @map("last_number")
  format         String // e.g. "[NO]/SMA-Q/[ROMA]/[YEAR]"
  resetPeriod    String @default("YEARLY") // YEARLY, MONTHLY

  // Relations
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, academicYearId, type])
  @@map("agenda_numbers")
}

/// Letter - Naskah Dinas (Surat Masuk/Keluar)
model Letter {
  id                String          @id @default(uuid())
  unitId            String          @map("unit_id")
  direction         LetterDirection
  /// Jenis naskah. Default SURAT_DINAS agar baris lama tetap bermakna.
  type              LetterType      @default(SURAT_DINAS)
  classificationId  String?         @map("classification_id")
  // Metadata
  agendaNumber      String?         @map("agenda_number") // Nomor Urut Agenda (Surat Masuk)
  letterNumber      String?         @map("letter_number") // Nomor Surat (Surat Keluar)
  date              DateTime        @db.Date // Tanggal Surat
  receivedAt        DateTime?       @map("received_at") // Tanggal Diterima (Surat Masuk)
  // Content
  subject           String // Perihal
  content           String?         @db.Text // Ringkasan atau Isi Surat
  fileUrl           String?         @map("file_url") // File Naskah Asli (Scan/PDF)
  // Attributes
  urgency           LetterUrgency   @default(NORMAL)
  nature            LetterNature    @default(PUBLIC)
  status            LetterStatus    @default(DRAFT)
  /// Jalur penyusunan naskah — lihat LetterAuthoringTrack.
  authoringTrack    LetterAuthoringTrack @default(GENERATED) @map("authoring_track")
  // External Parties (if not linked to User/Unit)
  senderName        String?         @map("sender_name") // Pengirim (External)
  senderTitle       String?         @map("sender_title")
  senderInstance    String?         @map("sender_instance") // Instansi Pengirim
  recipientName     String?         @map("recipient_name") // Penerima (External)
  recipientInstance String?         @map("recipient_instance")
  /// Kapan naskah ini benar-benar keluar dari kantor.
  ///
  /// Terpisah dari `date` (tanggal yang tercetak pada naskah) dan dari
  /// `updatedAt`: buku agenda surat keluar mencatat tanggal *pengiriman*, dan
  /// tanpa kolom ini tidak ada satu pun angka "surat terkirim" yang dapat
  /// dipertanggungjawabkan. Diisi pada pengiriman pertama dan tidak diubah
  /// oleh pengiriman susulan — lihat LetterDispatch.
  sentAt            DateTime?       @map("sent_at")

  // Relations
  unit           Unit                  @relation(fields: [unitId], references: [id])
  classification FilingClassification? @relation(fields: [classificationId], references: [id])
  createdById    String                @map("created_by_id")
  createdBy      User                  @relation("LetterCreator", fields: [createdById], references: [id])
  reviewers      LetterReviewer[]
  recipients     LetterRecipient[]
  dispositions   Disposition[]         @relation("LetterDispositions")
  flowEvents     LetterFlowEvent[]
  signatures     LetterSignature[]
  revocationRequests LetterRevocationRequest[]
  attachments    LetterAttachment[]
  dispatches     LetterDispatch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unitId])
  @@index([direction])
  @@index([status])
  @@index([date])
  @@index([sentAt])
  @@map("letters")
}

/// LetterReviewer - Workflow Persetujuan (Paraf/Tanda Tangan)
model LetterReviewer {
  id         String    @id @default(uuid())
  letterId   String    @map("letter_id")
  reviewerId String    @map("reviewer_id")
  order      Int       @default(1) // Urutan review (1, 2, 3...)
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED, REVISION
  isSigner   Boolean   @default(false) @map("is_signer") // True = Penandatangan akhir
  notes      String?   @db.Text
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  reviewer User   @relation(fields: [reviewerId], references: [id])

  @@unique([letterId, reviewerId])
  @@index([letterId])
  @@index([reviewerId])
  @@map("letter_reviewers")
}

/// LetterRecipient - Penerima Surat (Internal)
model LetterRecipient {
  id        String    @id @default(uuid())
  letterId  String    @map("letter_id")
  userId    String?   @map("user_id") // Penerima Internal User
  /// Unit **penerbit** surat, bukan unit penerima.
  ///
  /// Komentarnya dulu berbunyi "Penerima Unit", dan itu menggambarkan fitur
  /// yang tidak pernah dibuat: satu-satunya penulis kolom ini mengisinya dengan
  /// unit asal suratnya sendiri. Karena itu tidak ada satu pun baris yang
  /// pernah menunjuk unit sebagai penerima, dan membaca kolom ini sebagai
  /// penerima akan mencetak nama yayasan sendiri sebagai tembusannya sendiri.
  /// Tembusan kepada sebuah unit ditulis sebagai `externalName`, atau kepada
  /// pejabat unit itu lewat `userId`.
  unitId    String?   @map("unit_id")
  isCC      Boolean   @default(false) @map("is_cc") // Tembusan
  /// Penerima di luar sistem — nama ditulis tangan oleh penyusun.
  ///
  /// Tembusan naskah dinas sering ditujukan kepada pihak yang tidak punya akun
  /// di sini sama sekali: Kepala KUA, Ketua RW, dinas terkait. Tanpa kolom ini
  /// tembusan hanya bisa ditujukan ke dalam, dan penyusun terpaksa menuliskan
  /// sisanya di badan surat. Satu baris tembusan berisi `userId` **atau**
  /// `externalName`, tidak pernah keduanya.
  externalName String? @map("external_name")
  /// Urutan sebagaimana tercetak. Tembusan adalah daftar bernomor, dan nomor
  /// yang berubah-ubah setiap kali halaman dimuat bukan nomor.
  order     Int       @default(0)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
  unit   Unit?  @relation(fields: [unitId], references: [id])

  @@index([letterId, order])
  @@index([userId])
  @@map("letter_recipients")
}

/// LetterAttachment - Daftar lampiran naskah dinas
///
/// `Letter.fileUrl` adalah berkas naskahnya sendiri (pindaian surat masuk,
/// atau naskah yang diunggah), satu berkas dan bukan daftar. Lampiran adalah
/// hal yang berbeda: berkas-berkas yang *menyertai* naskah, dan yang
/// keberadaannya diumumkan pada kepala surat sebagai "Lampiran : 2 (dua)
/// berkas". Tanpa tabel ini surat keluar tidak dapat melampirkan apa pun, dan
/// baris "Lampiran" pada setiap naskah tercetak "-" apa pun keadaannya.
model LetterAttachment {
  id       String  @id @default(uuid())
  letterId String  @map("letter_id")
  /// Nama sebagaimana dibaca pengarsip, bukan nama berkas di penyimpanan.
  name     String
  fileUrl  String  @map("file_url")
  mimeType String? @map("mime_type")
  sizeBytes Int?   @map("size_bytes")
  /// Urutan sebagaimana disebut dalam naskah; lampiran adalah daftar bernomor.
  order    Int     @default(1)

  uploadedById String? @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  letter     Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation("LetterAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([letterId, order])
  @@map("letter_attachments")
}

/// Catatan pemilik sebuah berkas unggahan.
///
/// `Letter.fileUrl` menyimpan URL berkas naskah yang diunggah penyusunnya. URL
/// itu dapat disalin: seorang penyusun yang mengetahui URL unggahan orang lain
/// dapat menempelkannya sebagai `fileUrl` suratnya, lalu menandatangani dan
/// mengarsipkan berkas milik orang lain sebagai naskahnya sendiri — akses
/// lintas-pemilik yang tidak terdeteksi, sebab pembaca byte tidak memeriksa
/// siapa pemilik berkasnya.
///
/// Baris ini menutupnya: setiap unggahan yang sah mencatat pemiliknya, dan
/// penandatanganan menolak berkas yang bukan milik penanda tangan. Ia adalah
/// *indeks kepemilikan* — sesuatu yang sengaja tidak dimiliki `/uploads` saat
/// penyajian berkas (lihat `uploadsAuth`), tetapi wajib ada di sini karena
/// jalur ini menandatangani berkas sebagai naskah resmi.
model LetterUpload {
  id       String @id @default(uuid())
  /// Nama berkas tersimpan (`randomUUID` + ekstensi), bukan URL penuh.
  filename String @unique
  userId   String @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("LetterUploader", fields: [userId], references: [id])

  @@index([userId])
  @@map("letter_uploads")
}

/// Cara sebuah naskah keluar dari kantor.
enum LetterDispatchChannel {
  HAND_DELIVERY // Diantar langsung / diserahkan kepada yang bersangkutan
  COURIER // Kurir / ekspedisi
  POST // Pos
  EMAIL // Surel
  WHATSAPP
  OTHER
}

/// LetterDispatch - Buku ekspedisi surat keluar
///
/// Yang dicatat sebuah buku ekspedisi bukan "surat ini sudah dikirim"
/// melainkan *kapan*, *lewat apa*, *kepada siapa diserahkan*, dan *apa bukti
/// terimanya*. Status SENT saja tidak menjawab satu pun dari itu, dan ketika
/// penerima menyatakan tidak menerima surat, jawabannya justru ada di
/// keempatnya.
///
/// Satu naskah boleh punya lebih dari satu baris: surat yang sama diantar ke
/// beberapa alamat, atau dikirim ulang karena yang pertama tidak sampai.
/// `Letter.sentAt` tetap menunjuk pengiriman pertama.
model LetterDispatch {
  id             String                @id @default(uuid())
  letterId       String                @map("letter_id")
  dispatchedById String                @map("dispatched_by_id")
  dispatchedAt   DateTime              @map("dispatched_at")
  channel        LetterDispatchChannel
  /// Kepada siapa naskahnya diserahkan — orang, bukan instansi tujuan surat.
  receivedByName String?               @map("received_by_name")
  /// Nomor resi ekspedisi, bila ada.
  trackingNumber String?               @map("tracking_number")
  /// Tanda terima terpindai.
  receiptUrl     String?               @map("receipt_url")
  note           String?               @db.Text
  createdAt      DateTime              @default(now()) @map("created_at")

  letter       Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  dispatchedBy User   @relation("LetterDispatcher", fields: [dispatchedById], references: [id])

  @@index([letterId, dispatchedAt])
  @@map("letter_dispatches")
}

/// Disposition - Disposisi Surat
model Disposition {
  id                  String    @id @default(uuid())
  letterId            String    @map("letter_id")
  senderId            String    @map("sender_id") // Pemberi Disposisi
  recipientId         String    @map("recipient_id") // Penerima Disposisi
  instruction         String    @db.Text // Isi Instruksi (e.g., "Tindak Lanjuti", "Arsipkan")
  deadline            DateTime?
  status              String    @default("PENDING") // PENDING, COMPLETED, IN_PROGRESS
  notes               String?   @db.Text // Catatan tambahan / Laporan hasil
  completedAt         DateTime? @map("completed_at")
  parentDispositionId String?   @map("parent_disposition_id") // Untuk disposisi berjenjang

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  letter            Letter        @relation("LetterDispositions", fields: [letterId], references: [id], onDelete: Cascade)
  sender            User          @relation("DispositionSender", fields: [senderId], references: [id])
  recipient         User          @relation("DispositionRecipient", fields: [recipientId], references: [id])
  parentDisposition Disposition?  @relation("DispositionHierarchy", fields: [parentDispositionId], references: [id])
  childDispositions Disposition[] @relation("DispositionHierarchy")

  @@index([letterId])
  @@index([senderId])
  @@index([recipientId])
  @@map("dispositions")
}

// =====================================
// PHASE 13: QUALITY ASSURANCE (SPMI)
// =====================================

enum QualityStandardType {
  STANDAR_ISI
  STANDAR_PROSES
  STANDAR_KOMPETENSI_LULUSAN
  STANDAR_PENDIDIK_DAN_TENAGA_KEPENDIDIKAN
  STANDAR_SARANA_DAN_PRASARANA
  STANDAR_PENGELOLAAN
  STANDAR_PEMBIAYAAN
  STANDAR_PENILAIAN_PENDIDIKAN
}

enum AuditStatus {
  PLANNED
  ONGOING
  COMPLETED
  CLOSED
}

/// QualityStandard - 8 Standar Nasional Pendidikan
model QualityStandard {
  id          String              @id @default(uuid())
  type        QualityStandardType @unique // One record per standard type
  name        String // "Standar Isi", "Standar Proses"
  description String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  // Relations
  indicators QualityIndicator[]

  @@map("quality_standards")
}

/// QualityIndicator - Indikator per Standar
model QualityIndicator {
  id          String   @id @default(uuid())
  standardId  String   @map("standard_id")
  code        String // "1.1", "1.2"
  name        String
  description String?  @db.Text
  targetScore Float    @default(100) @map("target_score")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  standard   QualityStandard    @relation(fields: [standardId], references: [id], onDelete: Cascade)
  evidences  QualityEvidence[]
  auditItems QualityAuditItem[]

  @@index([standardId])
  @@map("quality_indicators")
}

/// QualityEvidence - Bukti Fisik Akreditasi
model QualityEvidence {
  id             String   @id @default(uuid())
  unitId         String   @map("unit_id")
  indicatorId    String   @map("indicator_id")
  academicYearId String   @map("academic_year_id")
  name           String // "RPP Matematika Kelas 7"
  fileUrl        String   @map("file_url")
  description    String?  @db.Text
  uploadedById   String   @map("uploaded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  unit         Unit             @relation(fields: [unitId], references: [id])
  indicator    QualityIndicator @relation(fields: [indicatorId], references: [id])
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id])
  uploadedBy   User             @relation("EvidenceUploader", fields: [uploadedById], references: [id])

  @@index([unitId])
  @@index([indicatorId])
  @@index([academicYearId])
  @@map("quality_evidences")
}

/// QualityAudit - Audit Mutu Internal (AMI)
model QualityAudit {
  id             String      @id @default(uuid())
  unitId         String      @map("unit_id")
  academicYearId String      @map("academic_year_id")
  code           String // "AMI-2024-01"
  name           String // "Audit Mutu Semester Ganjil"
  startDate      DateTime    @map("start_date")
  endDate        DateTime    @map("end_date")
  status         AuditStatus @default(PLANNED)
  leadAuditorId  String?     @map("lead_auditor_id")
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relations
  unit         Unit               @relation(fields: [unitId], references: [id])
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id])
  leadAuditor  User?              @relation("AuditLeader", fields: [leadAuditorId], references: [id])
  items        QualityAuditItem[]

  @@index([unitId])
  @@index([academicYearId])
  @@index([status])
  @@map("quality_audits")
}

/// QualityAuditItem - Detail Audit per Indikator
model QualityAuditItem {
  id          String   @id @default(uuid())
  auditId     String   @map("audit_id")
  indicatorId String   @map("indicator_id")
  score       Float? // Skor hasil audit
  notes       String?  @db.Text // Temuan audit
  auditorId   String?  @map("auditor_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  audit     QualityAudit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  indicator QualityIndicator @relation(fields: [indicatorId], references: [id])
  auditor   User?            @relation("Auditor", fields: [auditorId], references: [id])

  @@unique([auditId, indicatorId])
  @@index([auditId])
  @@index([indicatorId])
  @@map("quality_audit_items")
}

