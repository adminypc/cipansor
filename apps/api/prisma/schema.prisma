  // Asset management relations
  assetAssignments                  AssetAssignment[]
  createdAudits                     AssetAudit[]                @relation("AuditCreator")
  requestedMaintenances             AssetMaintenance[]          @relation("MaintenanceRequester")
  approvedDisposals                 AssetDisposal[]             @relation("DisposalApprover")

  // Tata Naskah Dinas (E-Office)
  createdLetters       Letter[]          @relation("LetterCreator")
  letterReviews        LetterReviewer[]
  receivedLetters      LetterRecipient[]
  sentDispositions     Disposition[]     @relation("DispositionSender")
  receivedDispositions Disposition[]     @relation("DispositionRecipient")
  letterFlowActions    LetterFlowEvent[] @relation("LetterFlowActor")
