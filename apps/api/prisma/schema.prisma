  mealAttendanceRecorded            MealAttendance[]            @relation("MealAttendanceRecorder")
  specialDietsApproved              SpecialDiet[]               @relation("DietApprover")
  calendarEventsCreated             CalendarEvent[]             @relation("EventCreator")
  studentDocumentsVerified          StudentDocument[]           @relation("DocumentVerifier")
