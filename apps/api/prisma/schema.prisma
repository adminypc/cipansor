/// The rating on an accreditation certificate (BAN-PDM, now BSANP).
enum AccreditationRating {
  A
  B
  C
}

/// A unit's accreditation as its certificate states it (decided 2026-09-28,
/// decisions/akreditasi-unit.md): one row per certificate, copied from it by
/// the unit's admin or the Super Admin, with the PDF itself as the proof. The
/// unit's accreditation now is its latest certificate still in force; the
/// public site, the EMIS and Dapodik exports and the SKHUN read it from here.
model UnitAccreditation {
  id                String              @id @default(uuid())
  unitId            String              @map("unit_id")
  rating            AccreditationRating
  certificateNumber String              @map("certificate_number")
  decreeNumber      String              @map("decree_number")
  decreedAt         DateTime            @map("decreed_at") @db.Date
  validUntil        DateTime            @map("valid_until") @db.Date
  /// As printed on the certificate: "BAN-PDM", later "BSANP".
  issuer            String              @default("BAN-PDM")
  /// The certificate PDF, kept in the database so the nightly backup holds it.
  certificatePdf    Bytes               @map("certificate_pdf")
  certificateSha256 String              @map("certificate_sha256")
  /// When the kepala and the admin of the unit were told it runs out within a year.
  reminderSentAt    DateTime?           @map("reminder_sent_at")
  recordedById      String              @map("recorded_by_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  unit       Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  recordedBy User @relation("UnitAccreditationRecorder", fields: [recordedById], references: [id])

  @@index([unitId, validUntil])
  @@map("unit_accreditations")
}

