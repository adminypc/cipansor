/// ChatbotPersona - the editable tone/style layer for the AI assistant, keyed
/// by scope ("public" today; role codes when the authenticated agent lands).
///
/// This is PERSONA ONLY: greeting, warmth, emoji, closing offer. It is appended
/// BELOW the safety scaffold and can never revoke a rule — the rules that keep
/// the bot from inventing fees or leaking private data live in code
/// (apps/api/src/modules/chatbot/prompt.ts), not here. That split is why this
/// field is safe to expose to a super admin for editing. Absent row → the code
/// default (DEFAULT_PERSONA) applies.
model ChatbotPersona {
  id        String   @id @default(uuid())
  scope     String   @unique
  persona   String   @db.Text
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chatbot_personas")
}

/// ChatbotUsageDaily — berapa banyak yang benar-benar dibelanjakan asisten
/// publik, dijumlahkan per hari per model.
///
/// Endpoint `/api/chatbot/public/ask` terbuka untuk siapa pun di internet dan
/// membelanjakan uang pada setiap panggilan. Pembatas 10/menit per IP dan
/// Turnstile membatasi *laju*-nya; tidak ada satu pun dari keduanya yang
/// memberi tahu bahwa tagihannya sedang menanjak. Tabel inilah yang menjawab
/// itu, dan `chatbot-spend.job.ts` yang membacanya.
///
/// **Agregat harian, bukan satu baris per pertanyaan.** Satu baris per
/// panggilan akan menumbuhkan tabel tanpa batas dan menyimpan jejak
/// pertanyaan-demi-pertanyaan milik pengunjung anonim — data yang tidak kami
/// perlukan untuk menjawab "berapa biayanya bulan ini". Bentuk ini terbatas
/// dengan sendirinya: satu baris per hari per model.
///
/// Jawaban yang dilayani dari cache **tidak** dicatat di sini. Yang dihitung
/// tabel ini adalah panggilan yang benar-benar sampai ke penyedia, karena
/// hanya itu yang ditagih.
model ChatbotUsageDaily {
  id String @id @default(uuid())

  /// Tanggal WIB pemakaiannya, bukan UTC — tagihan dibaca orang yang hidup di
  /// Asia/Jakarta, dan pekerjaan penjadwalnya juga berjalan di zona itu.
  date  DateTime @db.Date
  /// Model yang menjawab, seperti yang dikembalikan penyedia. Menjadi bagian
  /// kunci karena harganya melekat pada model, bukan pada layanannya.
  model String

  /// Panggilan yang sampai ke penyedia dan berhasil.
  requests         Int @default(0)
  promptTokens     Int @default(0) @map("prompt_tokens")
  completionTokens Int @default(0) @map("completion_tokens")

  /// Bagian dari `promptTokens` yang dilayani dari cache milik PENYEDIA, yang
  /// ditagih jauh lebih murah (Azure: 0,028 lawan 0,19 USD per 1 juta).
  ///
  /// DIKOREKSI 2026-09-04: kolom ini semula didokumentasikan akan selalu nol,
  /// karena satu jawaban yang diperiksa tidak memuat
  /// `prompt_tokens_details.cached_tokens`. Kesimpulan itu terlalu luas dari
  /// satu pengamatan — jawaban itu kebetulan tidak kena cache. Produksi hari
  /// yang sama mencatat 2.304 dari 8.589 token masukan berasal dari cache,
  /// jadi tarif cache memang terpakai dan medannya memang dilaporkan, hanya
  /// tidak pada setiap jawaban.
  ///
  /// Nol tetap mungkin dan tetap bermakna: ia berarti "tidak ada yang kena
  /// cache bulan ini", dan `estimateCost` membacanya sebagai tanda bahwa
  /// taksirannya condong ke atas — bukan sebagai kepastian bahwa penyedianya
  /// bisu.
  cachedPromptTokens Int @default(0) @map("cached_prompt_tokens")

  /// Panggilan berhasil yang jawabannya tidak menyertakan blok `usage`.
  ///
  /// Ada gerbang yang menghilangkannya. Tanpa kolom ini, panggilan seperti itu
  /// akan tampak gratis dan taksiran biayanya menjadi bohong yang meyakinkan;
  /// dengan kolom ini, taksirannya dapat dinyatakan apa adanya — sebagai batas
  /// bawah, bukan angka pasti.
  unmeteredRequests Int @default(0) @map("unmetered_requests")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date, model])
  @@index([date])
  @@map("chatbot_usage_daily")
}

/// ChatbotConversation - satu sesi tanya-jawab dengan asisten publik.
///
/// Sampai sekarang isi percakapannya sengaja TIDAK disimpan: pengunjung
/// mengetikkan hal pribadi ke kotak obrolan ("anak saya bernama…"), dan log
/// adalah tempat yang salah untuk itu berakhir. Menyimpannya kini menjadi
/// keputusan sadar dengan tiga pagar yang membuatnya bertanggung jawab:
/// hanya Super Admin yang bisa membacanya, isinya dihapus otomatis setelah 90
/// hari, dan tidak ada IP maupun sidik jari peramban yang ikut disimpan —
/// cukup untuk memperbaiki jawaban yang keliru, tidak cukup untuk melacak
/// orang.
model ChatbotConversation {
  id String @id @default(uuid())

  /// Pengenal yang dibuat peramban, satu per jendela obrolan yang dibuka.
  /// Unik supaya giliran kedua dan seterusnya menempel pada percakapan yang
  /// sama alih-alih membuat baris baru.
  clientId String @unique @map("client_id")

  startedAt     DateTime @default(now()) @map("started_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  /// Dihitung saat menulis, bukan saat membaca: daftar percakapan mengurutkan
  /// dan menyaring dengan angka ini, dan menghitung ulang relasi untuk setiap
  /// baris di halaman daftar adalah kueri N+1 yang menunggu terjadi.
  messageCount Int @default(0) @map("message_count")

  messages ChatbotMessage[]

  @@index([lastMessageAt])
  @@map("chatbot_conversations")
}

/// ChatbotMessage - satu giliran, entah dari pengunjung atau dari asisten.
/// Nasib satu penerusan pertanyaan ke halo@cipansor.or.id.
///
/// Suratnya TIDAK dikirim di dalam permintaan HTTP penanya. Barisnya ditulis
/// lebih dulu dan jawabannya dikembalikan seketika; pengirimannya dicoba
/// sesudah itu, dan diulang oleh penjadwal bila gagal. Inilah antrian tahan
/// lama yang memang tepat di sini — berbeda dari obrolannya sendiri, penanya
/// tidak sedang menunggui surat itu terkirim.
enum ChatbotEscalationStatus {
  /// Menunggu percobaan pertama, atau menunggu percobaan ulang.
  PENDING
  SENT
  /// Sudah menyerah setelah batas percobaan. Ditinjau manusia, bukan dibuang.
  FAILED
}

/// Pertanyaan yang tidak bisa dijawab asisten, diteruskan ke tim atas
/// persetujuan penanyanya.
///
/// Isinya DATA PRIBADI yang diberikan sukarela: nama, telepon, WhatsApp,
/// surel. Karena itu tiga pagar yang sama seperti riwayat percakapan berlaku —
/// hanya SUPER_ADMIN yang boleh membacanya lewat API, ia terhapus otomatis
/// setelah 90 hari, dan tidak ada IP maupun sidik jari peramban yang ikut
/// disimpan. Persetujuannya sendiri dicatat dengan stempel waktu, karena
/// "pernah setuju" tanpa kapan bukan catatan persetujuan.
model ChatbotEscalation {
  id String @id @default(uuid())

  /// Percakapan asalnya, bila widget-nya mengirimkannya. Sengaja BUKAN relasi:
  /// percakapan terhapus setelah 90 hari lewat jalurnya sendiri, dan penerusan
  /// yang belum terkirim tidak boleh ikut terhapus bersamanya.
  conversationId String? @map("conversation_id")

  name     String
  email    String
  /// Keduanya opsional: memaksa dua nomor pada orang yang hanya punya satu
  /// membuat ia mengarang salah satunya, dan nomor karangan lebih buruk
  /// daripada kolom kosong.
  phone    String?
  whatsapp String?

  /// Pertanyaan yang hendak diteruskan, sebagaimana diketik penanyanya.
  question String

  /// Kapan penanya menyatakan berkenan diteruskan. Wajib, dan disimpan sebagai
  /// waktu — bukan boolean — karena UU PDP menuntut bukti kapan persetujuan
  /// diberikan, bukan sekadar bahwa ia ada.
  consentAt DateTime @map("consent_at")

  status   ChatbotEscalationStatus @default(PENDING)
  /// Berapa kali pengiriman sudah dicoba. Membatasi pengulangan, dan menjadi
  /// petunjuk pertama ketika satu baris tersangkut.
  attempts Int                     @default(0)
  /// Alasan kegagalan terakhir, untuk dibaca manusia. Tanpa ini, sebuah baris
  /// FAILED tidak memberi tahu apa pun tentang cara memperbaikinya.
  lastError String?                 @map("last_error")
  sentAt    DateTime?               @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Penjadwal memindai baris yang belum terkirim menurut umurnya.
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("chatbot_escalations")
}

model ChatbotMessage {
  id             String              @id @default(uuid())
  conversationId String              @map("conversation_id")
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// "user" atau "assistant". Peran "system" tidak pernah muncul di sini:
  /// scaffold keamanan tinggal di kode dan tidak pernah datang dari peramban.
  role    String
  content String @db.Text

  /// Sumber yang dikutip asisten, apa adanya seperti yang dikirim ke widget.
  /// Disimpan supaya pertanyaan "dari mana angka itu?" masih bisa dijawab
  /// berbulan-bulan kemudian, ketika korpusnya sudah berubah.
  sources Json?

  /// Benar bila jawabannya adalah penolakan yang ditulis tangan — pertanyaan
  /// yang tidak menarik satu potongan pun. Inilah yang dibaca untuk menemukan
  /// lubang di basis pengetahuan.
  refused Boolean @default(false)

  /// Benar bila jawabannya dilayani dari cache dan tidak menelan biaya.
  fromCache Boolean @default(false) @map("from_cache")

  /// Model yang menjawab, bila ada. Kosong untuk giliran pengunjung.
  model String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@map("chatbot_messages")
}

/// RaporPesantren - Rapor Pesantren Terintegrasi
model RaporPesantren {
  id             String @id @default(uuid())
  studentId      String @map("student_id")
  unitId         String @map("unit_id")
  academicYearId String @map("academic_year_id")
  semester       Int // 1 or 2

  // Status
  status String @default("DRAFT") // DRAFT, FINAL, PUBLISHED

  // Component Data (stored as JSON)
  tahfidzData       Json? @map("tahfidz_data")
  takhosusData      Json? @map("takhosus_data")
  ibadahData        Json? @map("ibadah_data")
  muhadhorohData    Json? @map("muhadhoroh_data")
  muhadatsahData    Json? @map("muhadatsah_data")
  kitabProgressData Json? @map("kitab_progress_data")
  akhlakData        Json? @map("akhlak_data")
  attendanceData    Json? @map("attendance_data")
  academicData      Json? @map("academic_data") // Ringkasan nilai akademik (modul Grade)

  // Overall Scores
  overallScore Float?  @map("overall_score")
  overallGrade String? @map("overall_grade")

  // Notes
  notes            String? @db.Text
  headTeacherNotes String? @map("head_teacher_notes") @db.Text
  musyrifNotes     String? @map("musyrif_notes") @db.Text
  principalNotes   String? @map("principal_notes") @db.Text

  // Metadata
  generatedAt DateTime  @default(now()) @map("generated_at")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

