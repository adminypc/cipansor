enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
  TRUE_FALSE
}

enum ExamAttemptStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  NEEDS_REVIEW
}

/// QuestionBank - Bank Soal
model QuestionBank {
  id          String   @id @default(uuid())
  unitId      String   @map("unit_id")
  teacherId   String   @map("teacher_id")
  subjectId   String?  @map("subject_id")
  title       String
  description String?  @db.Text
