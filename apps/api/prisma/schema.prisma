  growthRecords               GrowthRecord[]
  immunizationRecords         ImmunizationRecord[]
  visits                      StudentVisit[]
  packages                    StudentPackage[]
  assignmentSubmissions       AssignmentSubmission[]
  examAttempts                ExamAttempt[]
  /// Riwayat unit per tahun ajaran. `unitId` di atas adalah unit SEKARANG;
  /// yang ini menjawab "saat itu di unit mana" — lihat StudentUnitEnrollment.
  unitEnrollments             StudentUnitEnrollment[]
  /// NIS santri di tiap unit yang pernah menerimanya. `nis` di atas hanya NIS
  /// unit SEKARANG — lihat StudentUnitIdentifier.
  unitIdentifiers             StudentUnitIdentifier[]

  @@index([nis])
  @@index([unitId])
  @@index([status])
  @@index([provinceId])
  @@index([regencyId])
  @@map("students")
}

/// StudentParent - Link between students and parent users
model StudentParent {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  parentId  String   @map("parent_id")
  relation  String // father, mother, guardian
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
  @@map("student_parents")
}

/// ClassEnrollment - Student enrollment in classes
/// StudentUnitEnrollment - Riwayat satuan pendidikan per tahun ajaran.
///
/// `students.unit_id` hanya menyimpan unit SEKARANG, jadi setiap laporan yang
/// menyaring lewat `student: { unitId }` sebenarnya bertanya "unit santri ini
/// apa?" padahal yang dimaksud "saat itu unitnya apa?". Seorang santri yang naik
/// dari TK ke SD IT membawa seluruh catatan kesehatan, izin, penghargaan, dan
/// angka dasbor tahun-tahun TK-nya ikut berpindah ke SD IT — bukan karena ada
/// yang mengubah data, melainkan karena pertanyaannya salah. Tabel ini yang
/// menjawabnya, dan ia sumber tunggal riwayat unit.
///
/// Bentuknya mengikuti StudentSchoolAssociation pada Ed-Fi Enrollment Domain:
/// satu baris per (santri, unit, tahun ajaran), tanggal masuk wajib dan tanggal
/// keluar opsional; barisnya BERTAMBAH ketika santri berpindah — tidak pernah
/// ditimpa atau dihapus — dan sengaja terpisah dari pendaftaran kelas
/// (`ClassEnrollment`), yang menjawab pertanyaan lain: rombelnya yang mana.
/// NIS (Nomor Induk Siswa; di Dapodik: NIPD) santri PER UNIT.
///
/// NIS diterbitkan oleh satuan pendidikan, bukan oleh yayasan: buku induk dan
/// rapor SD IT memuat NIS SD IT, dan santri yang naik ke SMP IT menerima NIS
/// SMP IT tanpa kehilangan NIS lamanya di dokumen SD IT. `students.nis` hanya
/// bisa menyimpan satu, dan unik lintas yayasan — dua sekolah yang sama-sama
/// memulai dari "2024001" tidak bisa hidup berdampingan di sana. Tabel ini
/// menyimpan pasangan (santri, unit) → NIS, unik per unit (audit PR #489, B1).
///
/// Selama `students.nis` masih ada ia ditulis ganda dan selalu sama dengan NIS
/// unit sekarang (utils/student-nis.ts). Dokumen resmi (rapor, kartu, EMIS)
/// membaca dari sini lewat unit dokumennya. Migrasi: 20260914010000.
model StudentUnitIdentifier {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  unitId    String   @map("unit_id")
  nis       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id])

  /// Satu NIS per santri per unit.
  @@unique([studentId, unitId])
  /// Di satu unit, satu NIS hanya milik satu santri.
  @@unique([unitId, nis])
  @@map("student_unit_identifiers")
}

/// Pengenal santri (NISN/NIK) yang dikosongkan migrasi
/// 20260914000000_student_identifier_uniqueness karena bentuknya salah
/// (`reason` = 'format') atau dipakai lebih dari satu santri ('duplicate';
/// `keptStudentId` = santri yang mempertahankannya). Hanya jejak untuk petugas —
/// sengaja tanpa relasi, supaya catatannya tidak ikut terhapus bersama santrinya.
model LegacyIdentifierAudit {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  field         String
  value         String
  reason        String
  keptStudentId String?  @map("kept_student_id")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  @@index([studentId])
  @@map("legacy_identifier_audit")
}

model StudentUnitEnrollment {
  id             String    @id @default(uuid())
  studentId      String    @map("student_id")
  unitId         String    @map("unit_id")
  academicYearId String    @map("academic_year_id")
  /// Tanggal santri masuk unit ini pada tahun ajaran ini. Wajib: baris tanpa
  /// tanggal masuk tidak bisa menjawab pertanyaan apa pun tentang "saat itu".
  entryDate      DateTime  @map("entry_date") @db.Date
  /// Kosong berarti masih berjalan. Terisi berarti sudah selesai atau keluar —
  /// barisnya tetap tinggal sebagai riwayat.
  exitDate       DateTime? @map("exit_date") @db.Date
  /// Alasan keluar bila diketahui. Dijaga CHECK di basis data (lihat migrasi
  /// 20260912020000), bukan enum Postgres: daftar nilainya masih akan tumbuh.
  exitReason     String?   @map("exit_reason")
  /// Tingkat saat itu ("1", "7", "X"), disalin dari rombelnya sebagai cuplikan —
  /// kelasnya bisa dihapus, riwayatnya tidak boleh ikut hilang.
  gradeLevel     String?   @map("grade_level")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  /// Nama indeksnya dipatok eksplisit: nama bawaan Prisma untuk tiga kolom ini
  /// 64 karakter, satu lewat dari batas Postgres, jadi ia akan dipotong dan
  /// nama di basis data tidak lagi sama dengan yang dikira Prisma.
  @@unique([studentId, unitId, academicYearId], map: "student_unit_enrollments_student_unit_year_key")
  @@index([studentId, entryDate])
  @@index([unitId, academicYearId])
  @@index([academicYearId])
  @@map("student_unit_enrollments")
}

model ClassEnrollment {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  classId    String   @map("class_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  /// Kosakatanya di `packages/shared/src/types/student-status.ts`
  /// (CLASS_ENROLLMENT_STATUS) dan diikat CHECK `class_enrollments_status_check`.
  /// BEDA dari status santri: 'completed' ada di sini, 'alumni' tidak.
  status     String   @default("active") // active, completed, transferred, dropped
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
  @@index([status])
  @@map("class_enrollments")
}

/// Attendance - Daily attendance records
model Attendance {
  id           String           @id @default(uuid())
  studentId    String           @map("student_id")
  classId      String           @map("class_id")
  date         DateTime         @db.Date
  status       AttendanceStatus
  notes        String?
  recordedById String           @map("recorded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  student    Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class                @relation(fields: [classId], references: [id])
  recordedBy User                 @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  followUps  AttendanceFollowUp[]

  @@unique([studentId, classId, date])
  @@index([date])
  @@index([status])
  @@map("attendances")
}

/// How an unexplained absence was followed up (decisions/absensi-harian.md):
/// the wali kelas (a day pupil) or the musyrif (a santri mukim) contacts the
/// wali and records what came of it. One absence may take several contacts.
enum AttendanceFollowUpChannel {
  PHONE
  WHATSAPP
  IN_PERSON
  OTHER
}

/// What a contact found. ILL and EXCUSED give the reason, and the mark becomes
/// SICK or EXCUSED; NO_REASON closes the absence as Alpa; UNREACHABLE leaves
/// it open for another try.
enum AttendanceFollowUpOutcome {
  ILL
  EXCUSED
  NO_REASON
  UNREACHABLE
}

model AttendanceFollowUp {
  id            String                    @id @default(uuid())
  attendanceId  String                    @map("attendance_id")
  contactedById String                    @map("contacted_by_id")
  channel       AttendanceFollowUpChannel
  outcome       AttendanceFollowUpOutcome
  note          String?                   @db.Text
  createdAt     DateTime                  @default(now()) @map("created_at")

  attendance  Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  contactedBy User       @relation("AttendanceFollowUpBy", fields: [contactedById], references: [id])

  @@index([attendanceId])
  @@index([contactedById])
  @@map("attendance_follow_ups")
}

/// A pattern in a santri's attendance (decided 2026-09-28,
/// decisions/absensi-harian.md): absent — Alpa, Sakit or Izin — on at least
/// 10% of the days recorded this semester, once 10 days are recorded; or late
/// three times in 30 days.
enum AttendancePatternKind {
  ABSENCE
  LATE
}

/// When a pattern was first raised this semester, so the wali kelas, the guru
/// BK and a santri mukim's musyrif are told once, not every day. Which santri
/// show a pattern now is worked out from the register, not from this table.
model AttendancePatternFlag {
  id            String                @id @default(uuid())
  studentId     String                @map("student_id")
  kind          AttendancePatternKind
  /// The first day of the semester the pattern belongs to.
  semesterStart DateTime              @map("semester_start") @db.Date
  raisedAt      DateTime              @default(now()) @map("raised_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, kind, semesterStart])
  @@map("attendance_pattern_flags")
}

/// TahfidzRecord - Quran memorization records
model TahfidzRecord {
  id           String              @id @default(uuid())
  studentId    String              @map("student_id")
  activityType TahfidzActivityType @map("activity_type")
  surahNumber  Int                 @map("surah_number")
  surahName    String              @map("surah_name")
  ayahStart    Int                 @map("ayah_start")
  ayahEnd      Int                 @map("ayah_end")
  juz          Int
  totalAyah    Int                 @map("total_ayah")
  score        Float? // For assessment type
  notes        String?
  audioUrl     String?             @map("audio_url") // E-Simaan: recorded recitation for async review
  recordedAt   DateTime            @default(now()) @map("recorded_at")
  recordedById String              @map("recorded_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // Relations
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("TahfidzRecorder", fields: [recordedById], references: [id])

  @@index([studentId])
  @@index([activityType])
  @@index([surahNumber])
  @@index([juz])
  @@map("tahfidz_records")
}

/// TahfidzTarget - Target hafalan per santri per tahun ajaran
model TahfidzTarget {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  academicYearId String   @map("academic_year_id")
  targetJuz      Int      @map("target_juz") // Target juz yang harus dihafal
  targetAyah     Int?     @map("target_ayah") // Target ayat tambahan
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@map("tahfidz_targets")
}

/// HafidzStudent - Siswa yang telah menyelesaikan hafalan 30 Juz
model HafidzStudent {
  id          String   @id @default(uuid())
  studentId   String   @unique @map("student_id")
  completedAt DateTime @default(now()) @map("completed_at")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([completedAt])
  @@map("hafidz_students")
}

// =====================================
// PESANTREN MODELS (Dormitory Management)
// =====================================

/// Dormitory - Asrama
model Dormitory {
  id String @id @default(uuid())
  /// Unit **pengelola** — who runs the building, not who may see it.
  ///
  /// Null means the asrama is run at foundation level, which is the normal
  /// case here: santri study at SD IT / SMP IT / SMA Qur'an and board in the
  /// same asrama, so no single school owns it. This column used to be required,
  /// so the seed had to name one, and every asrama claimed to belong to SMP IT
  /// while housing santri from three units.
  ///
  /// Do not scope access on it — see assertRoomAccess() in
  /// dormitories.service.ts, which asks who lives in a room instead. Anything
  /// that wants "asrama for unit X" should ask the same way; the null-means-
  /// foundation idiom matches Announcement.unitId.
  unitId      String?   @map("unit_id")
  name        String // e.g., "Asrama Putra Al-Fatih", "Asrama Putri Khadijah"
  code        String    @unique // e.g., "AP-01"
  gender      Gender // Male or Female dormitory
  capacity    Int
  address     String?
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  unit               Unit?               @relation(fields: [unitId], references: [id])
  rooms              Room[]
  musyrifAssignments MusyrifAssignment[]

  @@index([unitId])
  @@index([gender])
  @@map("dormitories")
}

/// Room - Kamar di asrama
model Room {
  id          String   @id @default(uuid())
  dormitoryId String   @map("dormitory_id")
  name        String // e.g., "Kamar 101"
  floor       Int      @default(1)
  capacity    Int
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  dormitory          Dormitory           @relation(fields: [dormitoryId], references: [id])
  assignments        RoomAssignment[]
  musyrifAssignments MusyrifAssignment[]

  @@unique([dormitoryId, name])
  @@index([isActive])
  @@map("rooms")
}

/// RoomAssignment - Penempatan santri di kamar
model RoomAssignment {
  id         String    @id @default(uuid())
  studentId  String    @map("student_id")
  roomId     String    @map("room_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  endedAt    DateTime? @map("ended_at")
  isActive   Boolean   @default(true) @map("is_active")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id])

  @@index([studentId])
  @@index([roomId])
  @@index([isActive])
  @@map("room_assignments")
}

/// Permit - Perizinan santri
model Permit {
  id            String       @id @default(uuid())
  studentId     String       @map("student_id")
  type          PermitType
  reason        String       @db.Text
  destination   String? // Tujuan
  // The learner is off the pondok during the leave. PULANG, KELUAR and
  // KELUARGA always are; for SAKIT and OTHER the filer says (UKS or home).
  // A santri mukim off the pondok overnight is the koordinator asrama's to
  // decide (decisions/pemutus-izin-santri.md).
  offCampus     Boolean      @default(true) @map("off_campus")
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  status        PermitStatus @default(PENDING)
  approvedById  String?      @map("approved_by_id")
  approvedAt    DateTime?    @map("approved_at")
  rejectionNote String?      @map("rejection_note")
  departedAt    DateTime?    @map("departed_at")
  returnedAt    DateTime?    @map("returned_at")
  code          String?      @unique // Unique short code for scanning
  // In what capacity `approvedBy` decided, and whether a unit head decided
  // what was the learner's own musyrif or wali kelas to decide.
  decidedAs     PermitDecider? @map("decided_as")
  tookOver      Boolean        @default(false) @map("took_over")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("PermitApprover", fields: [approvedById], references: [id])
  doctorNote PermitAttachment?

  @@index([studentId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([code])
  @@map("permits")
}

/// A doctor's note attached to a permit (decided 2026-09-28,
/// decisions/pemutus-izin-santri.md). A child's health data: opened only by
/// whoever decides the permit, the santri's wali and the unit head, each
/// opening audited; the file is erased when the academic year of the leave
/// ends (`retainUntil`), and what remains is that one was attached, its
/// SHA-256, and who saw it first.
model PermitAttachment {
  id              String    @id @default(uuid())
  permitId        String    @unique @map("permit_id")
  mimeType        String    @map("mime_type")
  sizeBytes       Int       @map("size_bytes")
  sha256          String
  /// The file itself; null once erased.
  content         Bytes?
  /// The last day of the academic year the leave starts in.
  retainUntil     DateTime  @map("retain_until") @db.Date
  erasedAt        DateTime? @map("erased_at")
  uploadedById    String    @map("uploaded_by_id")
  firstViewedById String?   @map("first_viewed_by_id")
  firstViewedAt   DateTime? @map("first_viewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  permit        Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  uploadedBy    User   @relation("PermitAttachmentUploader", fields: [uploadedById], references: [id])
  firstViewedBy User?  @relation("PermitAttachmentViewer", fields: [firstViewedById], references: [id])

  @@index([retainUntil])
  @@map("permit_attachments")
}

/// Violation - Pelanggaran santri
model Violation {
  id           String        @id @default(uuid())
  studentId    String        @map("student_id")
  type         ViolationType
  category     String // Kategori: ibadah, akhlak, kebersihan, ketertiban, dll
  description  String        @db.Text
  occurredAt   DateTime      @map("occurred_at")
  points       Int           @default(0) // Point deduction
  action       String? // Tindakan yang diberikan
  reportedById String        @map("reported_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("ViolationReporter", fields: [reportedById], references: [id])

  @@index([studentId])
  @@index([type])
  @@index([occurredAt])
  @@map("violations")
}

/// Reward - Penghargaan santri
model Reward {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  category    String // Kategori: tahfidz, akademik, akhlak, kebersihan, dll
  description String   @db.Text
  points      Int      @default(0) // Point addition
  givenAt     DateTime @default(now()) @map("given_at")
  givenById   String   @map("given_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  givenBy User    @relation("RewardGiver", fields: [givenById], references: [id])

  @@index([studentId])
  @@index([category])
  @@index([givenAt])
  @@map("rewards")
}

// =====================================
// FINANCE MODELS (Keuangan)
// =====================================

/// PaymentType - Jenis pembayaran
model PaymentType {
  id          String   @id @default(uuid())
  unitId      String   @map("unit_id")
  name        String // e.g., "SPP", "Uang Gedung", "Seragam"
  code        String // e.g., "SPP", "UG", "SRG"
  description String?
  amount      Decimal  @db.Decimal(15, 2) // Default amount
  isRecurring Boolean  @default(false) @map("is_recurring")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unit      Unit         @relation(fields: [unitId], references: [id])
  invoices  Invoice[]
  account   AccountCode? @relation(fields: [accountId], references: [id])
  accountId String?      @map("account_id")

  @@unique([unitId, code])
  @@index([isActive])
  @@map("payment_types")
}

/// Invoice - Tagihan pembayaran
model Invoice {
  id            String        @id @default(uuid())
  studentId     String        @map("student_id")
  paymentTypeId String        @map("payment_type_id")
  invoiceNumber String        @unique @map("invoice_number") // e.g., "INV-2024-0001"
  amount        Decimal       @db.Decimal(15, 2)
  dueDate       DateTime      @map("due_date")
  status        PaymentStatus @default(PENDING)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 2)
  period        String? // e.g., "Januari 2024" for monthly payments
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id])
  payments    Payment[]

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

/// Status verifikasi bukti pembayaran (maker-checker Tata Usaha)
enum PaymentVerificationStatus {
  PENDING_VERIFICATION // Bukti diunggah, menunggu verifikasi TU
  TU_APPROVED // Diverifikasi Tata Usaha, menunggu persetujuan akhir
  FINAL_APPROVED // Sah — tercatat ke tagihan & jurnal
  REJECTED // Ditolak (lihat rejectionReason)
}

/// Payment - Pembayaran
model Payment {
  id                 String                    @id @default(uuid())
  invoiceId          String                    @map("invoice_id")
  amount             Decimal                   @db.Decimal(15, 2)
  method             PaymentMethod
  referenceNo        String?                   @map("reference_no") // Nomor referensi bank/transfer
  proofUrl           String?                   @map("proof_url") // Bukti transfer (upload ortu)
  verificationStatus PaymentVerificationStatus @default(FINAL_APPROVED) @map("verification_status")
  rejectionReason    String?                   @map("rejection_reason")
  tuVerifiedAt       DateTime?                 @map("tu_verified_at")
  tuVerifiedById     String?                   @map("tu_verified_by_id")
  finalVerifiedAt    DateTime?                 @map("final_verified_at")
  finalVerifiedById  String?                   @map("final_verified_by_id")
  paidAt             DateTime                  @default(now()) @map("paid_at")
  notes              String?
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  // Relations
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tuVerifiedBy    User?   @relation("PaymentTUVerifier", fields: [tuVerifiedById], references: [id])
  finalVerifiedBy User?   @relation("PaymentFinalVerifier", fields: [finalVerifiedById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
  @@index([verificationStatus])
  @@map("payments")
}

