// Prisma Schema for Cipansor
// Yayasan Pesantren Cipansor - Islamic Education Institution Management System
// Supports: TK Qur'an, SD IT (Islam Terpadu), SMP IT (Islam Terpadu), SMA Qur'an with Tahfidz 30 Juz + Sanad

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  engineType      = "library"
  // NOTE: `nullsNotDistinct` on @@unique (so NULL values in a composite unique
  // key are treated as equal, PostgreSQL 15+) is GA in Prisma 7 and no longer
  // requires a preview flag. Used by the (unitId, businessUnitId, name/code)
  // constraints on CanteenCategory, CanteenItem and LaundryPricing.
}

datasource db {
  provider = "postgresql"
}

// =====================================
// ENUMS
// =====================================

// DEPRECATED: Legacy UserRole enum — no longer used in application code.
// Kept temporarily so that existing DB columns can be migrated.
// TODO: Remove this enum and the User.role column after running a data
// migration that ensures every user has a UserRoleAssignment.
enum UserRole {
  SUPER_ADMIN // Yayasan level admin
  UNIT_ADMIN // School/Unit level admin
  TEACHER // Guru/Ustadz
  STAFF // Non-teaching staff
  STUDENT // Santri/Siswa
  PARENT // Wali santri
}

// Realm - Domain/area of the system
enum Realm {
  GLOBAL // Super Admin - akses ke seluruh sistem
  YAYASAN // Yayasan/Foundation level
  TK_QURAN // TK Qur'an
  SD_IT // SD IT (Islam Terpadu)
  SMP_IT // SMP IT (Islam Terpadu)
  SMA_QURAN // SMA Qur'an
  PESANTREN // Pesantren (cross-unit)
  UNIT_USAHA // Business units (Kantin, Laundry, Koperasi, dll)
}

// RoleCode - All possible role codes in the system
//
// A role code is a function a person holds (guru, kepala sekolah, tata usaha,
// …). Duties added on top of a function are not role codes: wali kelas is
// `Class.homeroomTeacherId`, and wakasek and the other tugas tambahan are not
// modelled yet. `*_WAKASEK` and `*_WALI_KELAS` were merged into `*_GURU` on
// 2026-09-26 (migration 20260926120000_teacher_duties_not_roles).
enum RoleCode {
  // Global
  SUPER_ADMIN

  // Yayasan roles
  //
  // No YAYASAN_ADMIN: foundation-level administration is performed by
  // SUPER_ADMIN. Every `authorize()` that once listed YAYASAN_ADMIN also
  // listed SUPER_ADMIN, so removing it changed no endpoint's reachability.
  // The remaining yayasan roles are governance organs (Pembina, Pengurus,
  // Pengawas), not administrators.
  YAYASAN_PEMBINA
  YAYASAN_KETUA
  YAYASAN_SEKRETARIS
  YAYASAN_BENDAHARA
  YAYASAN_ANGGOTA
  YAYASAN_PENGAWAS

  // TK Qur'an roles
  TKQ_ADMIN
  TKQ_KEPALA_SEKOLAH
  TKQ_GURU
  // No TKQ_GURU_BK: a dedicated counselling teacher is not part of the TK
  // Qur'an establishment.
  TKQ_TATA_USAHA
  TKQ_BENDAHARA // Bendahara unit
  TKQ_KOMITE // Komite sekolah
  TKQ_ORANG_TUA
  // No TKQ_SISWA / TKQ_ALUMNI: children of TK Qur'an age do not hold logins,
  // and there is no alumni portal for them. Student records still exist —
  // `student.service.ts` creates the User row with the legacy STUDENT role and
  // no RoleCode assignment, so `students.user_id` (NOT NULL) is still
  // satisfied. Guardians use TKQ_ORANG_TUA.

  // SD IT (Islam Terpadu) roles
  SDIT_ADMIN
  SDIT_KEPALA_SEKOLAH
  SDIT_GURU
  // No SDIT_GURU_BK: counselling at SD IT is handled by the wali kelas.
  SDIT_TATA_USAHA
  SDIT_BENDAHARA
  SDIT_KOMITE
  SDIT_ORANG_TUA
  SDIT_SISWA
  // No SDIT_ALUMNI: primary-school alumni have no portal of their own.
  // SMPIT_ALUMNI and above are retained.

  // SMP IT (Islam Terpadu) roles
  SMPIT_ADMIN
  SMPIT_KEPALA_SEKOLAH
  SMPIT_GURU
  SMPIT_GURU_BK
  SMPIT_TATA_USAHA
  SMPIT_BENDAHARA
  SMPIT_KOMITE
  SMPIT_ORANG_TUA
  SMPIT_SISWA
  SMPIT_ALUMNI

  // SMA Qur'an roles
  SMAQ_ADMIN
  SMAQ_KEPALA_SEKOLAH
  SMAQ_GURU
  SMAQ_GURU_BK
  SMAQ_TATA_USAHA
  SMAQ_BENDAHARA
  SMAQ_KOMITE
  SMAQ_ORANG_TUA
  SMAQ_SISWA
  SMAQ_ALUMNI

  // Pesantren roles (cross-unit)
  PESANTREN_PENGASUH // Pimpinan Pesantren (Kiai) — no separate direktur (2026-09-25)
  PESANTREN_TATA_USAHA // Admin pesantren
  USTADZ // Guru pengampu kitab/pesantren
  MUSYRIF // Pembina asrama, wali kamar, murabbi — putra atau putri
  MUHAFIDZ // Pengampu tahfidz — putra atau putri

  // Cross-unit support staff (yayasan-wide services backed by real modules:
  // library, clinic/health, permits/gate security, practicum labs)
  PUSTAKAWAN // Pustakawan / pengelola perpustakaan
  PERAWAT // Perawat / petugas UKS & klinik
  KEAMANAN // Satpam / keamanan
  LABORAN // Laboran / petugas laboratorium & praktikum

  // Business Unit roles
  BUSINESS_MANAGER // Manajer unit usaha
  BUSINESS_STAFF // Staf unit usaha
}

