{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:strict": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --config prisma/prisma.config.ts",
    "db:push": "prisma db push --config prisma/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma/prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:presentasi": "tsx prisma/seed-presentasi.ts",
    "db:seed:spmb-2027-2028": "tsx prisma/seed-spmb-2027-2028.ts",
    "db:seed:ekskul-2027-2028": "tsx prisma/seed-ekskul-2027-2028.ts",
    "db:archive-letters": "tsx prisma/scripts/archive-signed-letters.ts",
    "db:purge-identity-documents": "tsx prisma/scripts/purge-identity-documents.ts",
    "db:retention-review": "tsx prisma/scripts/review-letter-retention.ts",
    "db:studio": "prisma studio --config prisma/prisma.config.ts",
    "chatbot:eval": "tsx src/modules/chatbot/eval/run.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cipansor/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "1.12.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "10.0.16",
    "otplib": "13.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "6.1.2",
    "winston": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitest/coverage-v8": "5.0.3",
    "axios": "1.20.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsc-alias": "1.9.7",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  }
}
