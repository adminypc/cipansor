# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright e2e auth state
playwright/.auth/
playwright/

# temporary/diagnostic e2e specs (underscore-prefixed)
e2e/_*.spec.ts
# …except the PWA screenshot capture, which is committed tooling: it is still
# skipped by playwright.config's testIgnore, but the manifest screenshots are
# regenerated with it (scripts/gen-pwa-assets.py), so it must travel with the repo.
!e2e/_capture-mobile.spec.ts

# e2e auth state
.auth/

# e2e screenshot temp artifacts
e2e/temp/

# per-role QA screenshot sweep output (scripts/screenshot-roles.ts)
.qa-screens/
.qa-all/
.qa-verify/
apps/web/
