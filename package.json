    "audit:deps": "node scripts/audit-deps.mjs"
  },
  "devDependencies": {
    "semver": "^7.7.3",
    "turbo": "2.11.7",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.11.2"
}
